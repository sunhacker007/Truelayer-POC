# OAuth Credentials (from console.truelayer.com)
CLIENT_ID=sandbox-your-client-id
CLIENT_SECRET=your-client-secret

# OAuth Redirect URI — must be registered in TrueLayer Console
# For Alibaba Cloud server: http://YOUR_SERVER_IP:3000/callback
# For local: http://localhost:3000/callback
REDIRECT_URI=http://localhost:3000/callback

# TrueLayer Endpoints
AUTH_BASE_URL=https://auth.truelayer-sandbox.com
DATA_API_BASE_URL=https://api.truelayer-sandbox.com/data/v1

# Payments API (not used in BNPL POC, kept for reference)
KID=3d42fee8-af49-465d-810d-463c02fc092c
PRIVATE_KEY_PATH=/home/admin/Truelayer-POC/private.pem
API_BASE_URL=https://api.truelayer-sandbox.com
